APP_ENV=development
APP_PORT=8080

DATABASE_URL=postgres://our_sell:our_sell@localhost:5432/our_sell?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Development-only value. Use a secret manager with a unique 32+ byte value in production.
JWT_SECRET=dev-only-change-this-secret-to-a-random-value-at-least-32-bytes
JWT_ISSUER=our-sell-api
JWT_AUDIENCE=our-sell-client
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_CIDRS=
TRUST_FORWARDED_HEADERS=false
REQUEST_BODY_LIMIT=1048576
SHUTDOWN_TIMEOUT=10s

REFRESH_COOKIE_NAME=refresh_token
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_TOKEN_TTL=1h
RATE_LIMIT_FAIL_OPEN=false

# Reserved for an SMTP/provider Mailer adapter; the default development mailer is token-blind.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
