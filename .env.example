APP_ENV=development
APP_PORT=8080

DATABASE_URL=postgres://our_sell:our_sell@localhost:5432/our_sell?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Development-only value. Use a secret manager with a unique 32+ byte value in production.
JWT_SECRET=dev-only-change-this-secret-to-a-random-value-at-least-32-bytes
JWT_ISSUER=our-sell-api
JWT_AUDIENCE=our-sell-client
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_CIDRS=
TRUST_FORWARDED_HEADERS=false
REQUEST_BODY_LIMIT=1048576
SHUTDOWN_TIMEOUT=10s

REFRESH_COOKIE_NAME=refresh_token
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_TOKEN_TTL=1h
RATE_LIMIT_FAIL_OPEN=false

# Optional SMTP delivery. Leave SMTP_HOST empty to use the token-blind development mailer.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Our Sell
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=10s

# Optional absolute frontend URLs. The mailer adds ?token=... automatically.
EMAIL_VERIFICATION_URL=
PASSWORD_RESET_URL=

# Optional Meta/Facebook connection. Set all four Facebook values to enable it.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
FACEBOOK_FRONTEND_URL=http://localhost:3000
META_GRAPH_API_VERSION=v26.0
# Generate with: openssl rand -base64 32
FACEBOOK_TOKEN_ENCRYPTION_KEY=

# Optional Bakong/KHQR wallet top-up integration. Leave blank to keep wallet top-ups disabled.
# Register for a Bakong Open API token at https://api-bakong.nbc.gov.kh/register.
BAKONG_API_TOKEN=
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=Our Sell
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
BAKONG_STORE_LABEL=Our Sell Wallet
BAKONG_TOPUP_TTL=15m
BAKONG_MIN_TOPUP_USD=1
BAKONG_MAX_TOPUP_USD=10000
BAKONG_WEBHOOK_SECRET=
BAKONG_HTTP_TIMEOUT=10s
